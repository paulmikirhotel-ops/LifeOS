# Frontend environment template.
# In dev, the Vite proxy forwards /api to the Express server — no need to change this.
# In production (Vercel/Netlify), point at your deployed API:
#   VITE_API_URL=https://your-api.onrender.com/api
VITE_API_URL=/api

# Address used when you copy a meeting link. Leave empty to use the address LifeOS is open on.
# While testing on Wi-Fi, set it to this computer's HTTPS network address, e.g. https://192.168.1.20:5173
VITE_PUBLIC_URL=
