<?xml version="1.0" encoding="utf-8"?>
<!-- The startup screen: black, with the LifeOS logo in the middle at a fixed size (never stretched, on any phone shape). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000"/>
        </shape>
    </item>
    <item android:width="260dp" android:height="260dp" android:gravity="center">
        <bitmap android:src="@drawable/launch_logo" android:gravity="fill"/>
    </item>
</layer-list>
