# ── LifeOS server environment template ─────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env.
# The user provides the MongoDB connection string (Atlas or local).

NODE_ENV=development
PORT=5000

# MongoDB — local default; swap for your Atlas URI later, e.g.
# mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/lifeos
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lifeos

# JWT secrets — MUST be long random strings in production
# (generate: openssl rand -base64 48)
JWT_SECRET=dev-only-change-me
JWT_REFRESH_SECRET=dev-only-change-me-too

# Token lifetimes
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origin (CORS allowlist + cookie domain)
CLIENT_URL=http://localhost:5173

# Cookie settings
COOKIE_SECURE=false

# Email (Phase 3 — SMTP; leave blank to log verification links in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="LifeOS <no-reply@lifeos.local>"

# ── Meetings module ─────────────────────────────────────────────────────
# Recording storage — Cloudflare R2 (or any S3-compatible bucket). Keep the bucket PRIVATE.
# Leave unset in local development to use ./storage-dev (never use that on Render).
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Speech-to-text (server-side only). Provider: deepgram | none
STT_PROVIDER=deepgram
STT_API_KEY=
STT_MODEL=nova-3
STT_LANGUAGE=en
STT_LIVE=true      # near-live transcript while recording
STT_BATCH=true     # diarized full-recording pass after the meeting

# AI summaries / minutes / Ask-this-meeting (server-side only). Provider: anthropic | openai | none
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
# For AI_PROVIDER=openai (any OpenAI-compatible API) set AI_MODEL and optionally:
# AI_BASE_URL=https://api.openai.com/v1

MEETING_CHUNK_MAX_MB=3
MEETING_MAX_RECORDING_MB=500
